{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/insights.html",
      "headers": {
        "cache-control": "no-cache",
        "X-Frame-Options": ""
      }
    },
    {
      "route": "/api/llm",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/policy-updates.json",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/evidence-records.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/regional-statistics.json",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/us-trade-statistics.json",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/us-trade-evidence.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/us-investment-statistics.json",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/weekly-updates.xml",
      "headers": {
        "content-type": "application/atom+xml; charset=utf-8",
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/weekly-updates.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/api/weekly-subscription",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/weekly-updates.fr.xml",
      "headers": {
        "content-type": "application/atom+xml; charset=utf-8",
        "content-language": "fr",
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/weekly-updates.zh.xml",
      "headers": {
        "content-type": "application/atom+xml; charset=utf-8",
        "content-language": "zh-Hans",
        "cache-control": "no-cache"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "*.css",
      "*.js",
      "*.json",
      "*.xml"
    ]
  }
}
