{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/api/llm",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/policy-updates.json",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/evidence-records.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/regional-statistics.json",
      "headers": {
        "cache-control": "no-store"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "*.css",
      "*.js",
      "*.json"
    ]
  }
}
